{
  "name": "fuqua-concert",
  "version": "0.1.0",
  "description": "Fuqua ConCert: a course planner for the Duke Fuqua full-time MBA",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "node --test tests/rules/*.test.js",
    "test:extraction": "python -m pytest tests/extraction -q",
    "serve": "node tools/serve.js",
    "extract": "python tools/extraction/extract.py && python tools/extraction/build_courses.py",
    "verify": "python tools/extraction/verify.py"
  }
}
